<span class="line"><span style="color:#F97583">    def</span><span style="color:#B392F0"> _clean_text</span><span style="color:#E1E4E8">(self, text, method</span><span style="color:#F97583">=</span><span style="color:#9ECBFF">'lemmatize'</span><span style="color:#E1E4E8">):</span></span>
<span class="line"><span style="color:#9ECBFF">        """</span></span>
<span class="line"><span style="color:#9ECBFF">        Глубокая очистка и предобработка текста</span></span>
<span class="line"><span style="color:#9ECBFF">        </span></span>
<span class="line"><span style="color:#9ECBFF">        Args:</span></span>
<span class="line"><span style="color:#9ECBFF">            text: Исходный текст</span></span>
<span class="line"><span style="color:#9ECBFF">            method: 'lemmatize' или 'stem'</span></span>
<span class="line"><span style="color:#9ECBFF">            </span></span>
<span class="line"><span style="color:#9ECBFF">        Returns:</span></span>
