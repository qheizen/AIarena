<span class="line"><span style="color:#9ECBFF">            contamination: Ожидаемая доля аномалий</span></span>
<span class="line"><span style="color:#9ECBFF">            use_pca: Использовать PCA для снижения размерности</span></span>
<span class="line"><span style="color:#9ECBFF">            n_components: Количество главных компонент</span></span>
<span class="line"><span style="color:#9ECBFF">        """</span></span>
<span class="line"><span style="color:#79B8FF">        print</span><span style="color:#E1E4E8">(</span><span style="color:#9ECBFF">"</span><span style="color:#79B8FF">\n</span><span style="color:#9ECBFF">"</span><span style="color:#F97583"> +</span><span style="color:#9ECBFF"> "🎓 ОБУЧЕНИЕ ДЕТЕКТОРА АНОМАЛИЙ "</span><span style="color:#E1E4E8">.center(</span><span style="color:#79B8FF">80</span><span style="color:#E1E4E8">, </span><span style="color:#9ECBFF">"="</span><span style="color:#E1E4E8">))</span></span>
<span class="line"><span style="color:#E1E4E8">        </span></span>
<span class="line"><span style="color:#6A737D">        # Загрузка данных</span></span>
<span class="line"><span style="color:#79B8FF">        print</span><span style="color:#E1E4E8">(</span><span style="color:#F97583">f</span><span style="color:#9ECBFF">"</span><span style="color:#79B8FF">\n</span><span style="color:#9ECBFF">📥 Загрузка логов из: </span><span style="color:#79B8FF">{</span><span style="color:#E1E4E8">csv_path</span><span style="color:#79B8FF">}</span><span style="color:#9ECBFF">"</span><span style="color:#E1E4E8">)</span></span>
<span class="line"><span style="color:#E1E4E8">        df </span><span style="color:#F97583">=</span><span style="color:#E1E4E8"> pd.read_csv(csv_path)</span></span>
<span class="line"><span style="color:#E1E4E8">        </span></span>
<span class="line"><span style="color:#79B8FF">        print</span><span style="color:#E1E4E8">(</span><span style="color:#F97583">f</span><span style="color:#9ECBFF">"   ✅ Загружено записей: </span><span style="color:#79B8FF">{len</span><span style="color:#E1E4E8">(df)</span><span style="color:#79B8FF">}</span><span style="color:#9ECBFF">"</span><span style="color:#E1E4E8">)</span></span>
<span class="line"><span style="color:#79B8FF">        print</span><span style="color:#E1E4E8">(</span><span style="color:#F97583">f</span><span style="color:#9ECBFF">"   ✅ Колонок: </span><span style="color:#79B8FF">{len</span><span style="color:#E1E4E8">(df.columns)</span><span style="color:#79B8FF">}</span><span style="color:#9ECBFF">"</span><span style="color:#E1E4E8">)</span></span>
