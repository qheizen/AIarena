<span class="line"><span style="color:#F97583">    def</span><span style="color:#B392F0"> _calculate_baseline_statistics</span><span style="color:#E1E4E8">(self, df):</span></span>
<span class="line"><span style="color:#9ECBFF">        """</span></span>
<span class="line"><span style="color:#9ECBFF">        Вычисление базовой статистики для обнаружения аномалий</span></span>
<span class="line"><span style="color:#9ECBFF">        </span></span>
<span class="line"><span style="color:#9ECBFF">        Args:</span></span>
<span class="line"><span style="color:#9ECBFF">            df: DataFrame</span></span>
<span class="line"><span style="color:#9ECBFF">        """</span></span>
<span class="line"><span style="color:#79B8FF">        print</span><span style="color:#E1E4E8">(</span><span style="color:#F97583">f</span><span style="color:#9ECBFF">"</span><span style="color:#79B8FF">\n</span><span style="color:#9ECBFF">📊 ВЫЧИСЛЕНИЕ БАЗОВОЙ СТАТИСТИКИ"</span><span style="color:#E1E4E8">)</span></span>
<span class="line"><span style="color:#79B8FF">        print</span><span style="color:#E1E4E8">(</span><span style="color:#9ECBFF">"="</span><span style="color:#F97583">*</span><span style="color:#79B8FF">80</span><span style="color:#E1E4E8">)</span></span>
<span class="line"><span style="color:#E1E4E8">        </span></span>
<span class="line"><span style="color:#F97583">        for</span><span style="color:#E1E4E8"> col </span><span style="color:#F97583">in</span><span style="color:#79B8FF"> self</span><span style="color:#E1E4E8">.numeric_features </span><span style="color:#F97583">+</span><span style="color:#79B8FF"> self</span><span style="color:#E1E4E8">.time_features:</span></span>
<span class="line"><span style="color:#F97583">            if</span><span style="color:#E1E4E8"> col </span><span style="color:#F97583">in</span><span style="color:#E1E4E8"> df.columns:</span></span>
<span class="line"><span style="color:#79B8FF">                self</span><span style="color:#E1E4E8">.baseline_stats[col] </span><span style="color:#F97583">=</span><span style="color:#E1E4E8"> {</span></span>
<span class="line"><span style="color:#9ECBFF">                    'mean'</span><span style="color:#E1E4E8">: df[col].mean(),</span></span>
<span class="line"><span style="color:#9ECBFF">                    'std'</span><span style="color:#E1E4E8">: df[col].std(),</span></span>
<span class="line"><span style="color:#9ECBFF">                    'median'</span><span style="color:#E1E4E8">: df[col].median(),</span></span>
<span class="line"><span style="color:#9ECBFF">                    'q1'</span><span style="color:#E1E4E8">: df[col].quantile(</span><span style="color:#79B8FF">0.25</span><span style="color:#E1E4E8">),</span></span>
<span class="line"><span style="color:#9ECBFF">                    'q3'</span><span style="color:#E1E4E8">: df[col].quantile(</span><span style="color:#79B8FF">0.75</span><span style="color:#E1E4E8">),</span></span>
<span class="line"><span style="color:#9ECBFF">                    'iqr'</span><span style="color:#E1E4E8">: df[col].quantile(</span><span style="color:#79B8FF">0.75</span><span style="color:#E1E4E8">) </span><span style="color:#F97583">-</span><span style="color:#E1E4E8"> df[col].quantile(</span><span style="color:#79B8FF">0.25</span><span style="color:#E1E4E8">),</span></span>
<span class="line"><span style="color:#9ECBFF">                    'min'</span><span style="color:#E1E4E8">: df[col].min(),</span></span>
<span class="line"><span style="color:#9ECBFF">                    'max'</span><span style="color:#E1E4E8">: df[col].max()</span></span>
<span class="line"><span style="color:#E1E4E8">                }</span></span>
<span class="line"><span style="color:#E1E4E8">                </span></span>
<span class="line"><span style="color:#79B8FF">                print</span><span style="color:#E1E4E8">(</span><span style="color:#F97583">f</span><span style="color:#9ECBFF">"</span><span style="color:#79B8FF">\n</span><span style="color:#9ECBFF">   📈 </span><span style="color:#79B8FF">{</span><span style="color:#E1E4E8">col</span><span style="color:#79B8FF">}</span><span style="color:#9ECBFF">:"</span><span style="color:#E1E4E8">)</span></span>
<span class="line"><span style="color:#79B8FF">                print</span><span style="color:#E1E4E8">(</span><span style="color:#F97583">f</span><span style="color:#9ECBFF">"      Mean: </span><span style="color:#79B8FF">{self</span><span style="color:#E1E4E8">.baseline_stats[col][</span><span style="color:#9ECBFF">'mean'</span><span style="color:#E1E4E8">]</span><span style="color:#F97583">:.4f</span><span style="color:#79B8FF">}</span><span style="color:#9ECBFF">"</span><span style="color:#E1E4E8">)</span></span>
<span class="line"><span style="color:#79B8FF">                print</span><span style="color:#E1E4E8">(</span><span style="color:#F97583">f</span><span style="color:#9ECBFF">"      Std:  </span><span style="color:#79B8FF">{self</span><span style="color:#E1E4E8">.baseline_stats[col][</span><span style="color:#9ECBFF">'std'</span><span style="color:#E1E4E8">]</span><span style="color:#F97583">:.4f</span><span style="color:#79B8FF">}</span><span style="color:#9ECBFF">"</span><span style="color:#E1E4E8">)</span></span>
<span class="line"><span style="color:#79B8FF">                print</span><span style="color:#E1E4E8">(</span><span style="color:#F97583">f</span><span style="color:#9ECBFF">"      IQR:  </span><span style="color:#79B8FF">{self</span><span style="color:#E1E4E8">.baseline_stats[col][</span><span style="color:#9ECBFF">'iqr'</span><span style="color:#E1E4E8">]</span><span style="color:#F97583">:.4f</span><span style="color:#79B8FF">}</span><span style="color:#9ECBFF">"</span><span style="color:#E1E4E8">)</span></span>
<span class="line"><span style="color:#E1E4E8">        </span></span>
<span class="line"><span style="color:#79B8FF">        print</span><span style="color:#E1E4E8">(</span><span style="color:#9ECBFF">"="</span><span style="color:#F97583">*</span><span style="color:#79B8FF">80</span><span style="color:#E1E4E8">)</span></span>
