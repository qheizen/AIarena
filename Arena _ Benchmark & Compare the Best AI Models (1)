<span class="line"><span style="color:#F97583">    def</span><span style="color:#B392F0"> _detect_statistical_anomalies</span><span style="color:#E1E4E8">(self, df):</span></span>
<span class="line"><span style="color:#9ECBFF">        """</span></span>
<span class="line"><span style="color:#9ECBFF">        Обнаружение аномалий статистическими методами (Z-score, IQR)</span></span>
<span class="line"><span style="color:#9ECBFF">        </span></span>
<span class="line"><span style="color:#9ECBFF">        Args:</span></span>
<span class="line"><span style="color:#9ECBFF">            df: DataFrame</span></span>
<span class="line"><span style="color:#9ECBFF">            </span></span>
<span class="line"><span style="color:#9ECBFF">        Returns:</span></span>
<span class="line"><span style="color:#9ECBFF">            Массив с флагами аномалий</span></span>
<span class="line"><span style="color:#9ECBFF">        """</span></span>
<span class="line"><span style="color:#E1E4E8">        anomaly_scores </span><span style="color:#F97583">=</span><span style="color:#E1E4E8"> np.zeros(</span><span style="color:#79B8FF">len</span><span style="color:#E1E4E8">(df))</span></span>
<span class="line"><span style="color:#E1E4E8">        </span></span>
<span class="line"><span style="color:#F97583">        for</span><span style="color:#E1E4E8"> col </span><span style="color:#F97583">in</span><span style="color:#79B8FF"> self</span><span style="color:#E1E4E8">.numeric_features </span><span style="color:#F97583">+</span><span style="color:#79B8FF"> self</span><span style="color:#E1E4E8">.time_features:</span></span>
<span class="line"><span style="color:#F97583">            if</span><span style="color:#E1E4E8"> col </span><span style="color:#F97583">in</span><span style="color:#E1E4E8"> df.columns </span><span style="color:#F97583">and</span><span style="color:#E1E4E8"> col </span><span style="color:#F97583">in</span><span style="color:#79B8FF"> self</span><span style="color:#E1E4E8">.baseline_stats:</span></span>
<span class="line"><span style="color:#E1E4E8">                stats </span><span style="color:#F97583">=</span><span style="color:#79B8FF"> self</span><span style="color:#E1E4E8">.baseline_stats[col]</span></span>
<span class="line"><span style="color:#E1E4E8">                </span></span>
<span class="line"><span style="color:#6A737D">                # Z-score метод</span></span>
<span class="line"><span style="color:#E1E4E8">                z_scores </span><span style="color:#F97583">=</span><span style="color:#E1E4E8"> np.abs((df[col] </span><span style="color:#F97583">-</span><span style="color:#E1E4E8"> stats[</span><span style="color:#9ECBFF">'mean'</span><span style="color:#E1E4E8">]) </span><span style="color:#F97583">/</span><span style="color:#E1E4E8"> (stats[</span><span style="color:#9ECBFF">'std'</span><span style="color:#E1E4E8">] </span><span style="color:#F97583">+</span><span style="color:#79B8FF"> 1e-10</span><span style="color:#E1E4E8">))</span></span>
<span class="line"><span style="color:#E1E4E8">                anomaly_scores </span><span style="color:#F97583">+=</span><span style="color:#E1E4E8"> (z_scores </span><span style="color:#F97583">&gt;</span><span style="color:#79B8FF"> 3</span><span style="color:#E1E4E8">).astype(</span><span style="color:#79B8FF">int</span><span style="color:#E1E4E8">)</span></span>
<span class="line"><span style="color:#E1E4E8">                </span></span>
<span class="line"><span style="color:#6A737D">                # IQR метод</span></span>
<span class="line"><span style="color:#E1E4E8">                lower_bound </span><span style="color:#F97583">=</span><span style="color:#E1E4E8"> stats[</span><span style="color:#9ECBFF">'q1'</span><span style="color:#E1E4E8">] </span><span style="color:#F97583">-</span><span style="color:#79B8FF"> 1.5</span><span style="color:#F97583"> *</span><span style="color:#E1E4E8"> stats[</span><span style="color:#9ECBFF">'iqr'</span><span style="color:#E1E4E8">]</span></span>
<span class="line"><span style="color:#E1E4E8">                upper_bound </span><span style="color:#F97583">=</span><span style="color:#E1E4E8"> stats[</span><span style="color:#9ECBFF">'q3'</span><span style="color:#E1E4E8">] </span><span style="color:#F97583">+</span><span style="color:#79B8FF"> 1.5</span><span style="color:#F97583"> *</span><span style="color:#E1E4E8"> stats[</span><span style="color:#9ECBFF">'iqr'</span><span style="color:#E1E4E8">]</span></span>
<span class="line"><span style="color:#E1E4E8">                anomaly_scores </span><span style="color:#F97583">+=</span><span style="color:#E1E4E8"> ((df[col] </span><span style="color:#F97583">&lt;</span><span style="color:#E1E4E8"> lower_bound) </span><span style="color:#F97583">|</span><span style="color:#E1E4E8"> (df[col] </span><span style="color:#F97583">&gt;</span><span style="color:#E1E4E8"> upper_bound)).astype(</span><span style="color:#79B8FF">int</span><span style="color:#E1E4E8">)</span></span>
<span class="line"><span style="color:#E1E4E8">        </span></span>
<span class="line"><span style="color:#F97583">        return</span><span style="color:#E1E4E8"> anomaly_scores</span></span>
<span class="line"><span style="color:#E1E4E8">    </span></span>
