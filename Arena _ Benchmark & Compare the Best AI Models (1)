<span class="line"><span style="color:#E1E4E8">        </span></span>
<span class="line"><span style="color:#6A737D">        # 9. Лемматизация или стемминг</span></span>
<span class="line"><span style="color:#F97583">        if</span><span style="color:#E1E4E8"> method </span><span style="color:#F97583">==</span><span style="color:#9ECBFF"> 'lemmatize'</span><span style="color:#E1E4E8">:</span></span>
