<span class="line"><span style="color:#F97583">                    lambda</span><span style="color:#E1E4E8"> x: </span><span style="color:#79B8FF">self</span><span style="color:#E1E4E8">.encoders[col].transform([x])[</span><span style="color:#79B8FF">0</span><span style="color:#E1E4E8">] </span></span>
